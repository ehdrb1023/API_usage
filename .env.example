# =============================================================================
# API_usage — AI API 비용 대시보드 환경변수 템플릿
# =============================================================================
# 사용법:
#   cp .env.example .env  후 값 채우기. .env 는 절대 커밋하지 말 것(.gitignore 등록됨).
#
# 범위:
#   이 대시보드는 **AI API 비용만** 다룹니다 (2026-08-26 확정).
#   Vercel·Supabase·Grafana 항목은 같은 날 제거했습니다 — 코드가 읽지 않습니다.
#
# ⚠️ 여기 있는 변수는 **전부 코드가 실제로 읽는 것**입니다. 안 읽는 변수를 남겨 두면
#    "설정했는데 왜 안 바뀌지" 가 되므로, 쓰지 않게 된 변수는 이 파일에서도 지웁니다.
#    확인: grep -rhoE "process\.env\.[A-Z_0-9]+" lib app components | sort -u
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Anthropic Admin API  (Claude 탭)  ✅ 2026-08-14 실키 검증 완료
# -----------------------------------------------------------------------------
# 발급: Console → Settings → Admin keys (조직 Owner 권한 필요)
#       일반 API 키(sk-ant-api...)로는 호출 불가. 반드시 Admin 키(sk-ant-admin...).
# 인증 헤더: x-api-key: $ANTHROPIC_ADMIN_KEY
#            anthropic-version: $ANTHROPIC_API_VERSION
#
# 쓰는 엔드포인트 (조회 파라미터는 lib/services.ts 에 있습니다):
#   GET /v1/organizations/usage_report/messages   bucket_width=1h  ← KST 재구성에 필요
#   GET /v1/organizations/cost_report             bucket_width=1d  ← 단가 역산에만 사용
#   GET /v1/organizations/api_keys                                 ← 키 이름 표시
#
# ⚠️ usage_report / cost_report 는 **시간당 90회** 입니다
#    (2026-08-25 실측: anthropic-ratelimit-requests-limit: 90).
#    아래 LIVE_REFRESH_SECONDS 설명을 함께 읽으세요.
ANTHROPIC_ADMIN_KEY=sk-ant-admin01-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_VERSION=2023-06-01
ANTHROPIC_API_BASE=https://api.anthropic.com


# -----------------------------------------------------------------------------
# 2. OpenAI Admin API  (GPT 탭)  ⚠️ 자리만 마련된 상태 — 실키 미검증
# -----------------------------------------------------------------------------
# 발급: Platform → Settings → Organization → Admin keys (조직 Owner 권한 필요)
#       프로젝트 키(sk-proj-...)로는 호출 불가. 반드시 Admin 키(sk-admin-...).
# 인증 헤더: Authorization: Bearer $OPENAI_ADMIN_KEY
#
# 쓰는 엔드포인트 (⚠️ 경로가 **단수** organization 입니다 — Anthropic 과 다름):
#   GET /v1/organization/usage/completions   bucket_width=1h  ← KST 재구성에 필요
#   GET /v1/organization/costs               bucket_width=1d  ← 단가 역산에만 사용
#   GET /v1/organization/projects                             ← 프로젝트 이름 표시
#
# ★ 이 키를 채우면 GPT 탭이 **자동으로 켜집니다.** 비워 두면 탭이 아예 안 뜹니다
#   (판정: lib/clients/openai.ts 의 hasOpenAiCredentials).
#
# ⚠️ 켜기 전에 docs/openai-integration.md 의 체크리스트를 먼저 돌리세요.
#    필드명·페이지네이션·금액 단위가 전부 문서 기준이고 실응답으로 확인되지
#    않았습니다. 틀려도 화면에는 그럴듯한 숫자가 뜹니다.
OPENAI_ADMIN_KEY=
# 조직이 하나뿐이면 비워 두어도 됩니다. 여럿이면 지정하지 않을 때 엉뚱한 조직이 잡힙니다.
OPENAI_ORG_ID=
OPENAI_API_BASE=https://api.openai.com


# -----------------------------------------------------------------------------
# 3. 대시보드 동작
# -----------------------------------------------------------------------------
# mock = mock/*.json 목업 데이터 사용 (API 키 불필요, 기본값)
# api  = 실제 API 호출 (위의 키가 채워져 있어야 함)
# 읽는 곳: lib/data-source.ts — 목업/실API 분기는 이 파일 한 곳뿐
DATA_SOURCE=mock

# ── 미니 위젯(/mini) 실시간 갱신 주기 (초). 기본 60. 30 미만은 무시하고 60을 씁니다.
#
# ⚠️ Anthropic Admin API 는 **시간당 90회** 입니다. 60초 주기면 60회/시간을 씁니다 —
#    한 곳에서만 돌면 들어가지만, 로컬 개발 서버와 배포본이 같은 Admin 키로
#    **동시에** 돌면 120회가 되어 429 가 납니다. 그럴 때는 120 이상으로 올리세요.
#
#    벤더가 둘이어도 쿼터는 벤더별로 따로 셉니다 — GPT 탭을 켠다고 Claude 쿼터가
#    줄지는 않습니다.
LIVE_REFRESH_SECONDS=60


# ── 구독 한도 잔량을 읽어 올 자격증명 파일 (선택)
#
# 미니 위젯의 "5시간 / 이번 주" 막대가 여기서 나옵니다. Claude Code 가 로그인
# 토큰을 두는 파일이고, 기본값은 ~/.claude/.credentials.json 입니다.
# 위치를 옮겨 쓰는 게 아니면 **건드릴 필요가 없습니다.**
#
# ⚠️ 이 값은 **로컬에서만** 의미가 있습니다. 배포본에는 이 파일이 없어서 한도
#    막대가 아예 안 뜹니다 — 고장이 아니라 원래 안 되는 것입니다.
#
# ⚠️ 한도는 Admin API 가 아니라 Claude Code 가 /usage 에 쓰는 **비공개 엔드포인트**
#    에서 옵니다. 언젠가 응답이 바뀔 수 있고, 그때는 한도 줄만 "조회 실패" 로
#    빠지고 나머지 숫자는 그대로 나옵니다.
#
# ⚠️ 여기서 나오는 건 **퍼센트지 토큰 개수가 아닙니다.** 정액 구독이라 벤더가
#    상한을 공개하지 않습니다. "49% 남음" 이 최선입니다.
# CLAUDE_CREDENTIALS_PATH=/home/me/.claude/.credentials.json


# -----------------------------------------------------------------------------
# 4. 도구 전용  — **앱은 안 읽습니다**
# -----------------------------------------------------------------------------
# scripts/ 안의 운영 도구만 씁니다. 배포 환경변수에는 넣지 마세요.
#
#   scripts/attach_subdomain.mjs    speciai.kr 서브도메인 붙이기
#   scripts/scan_key_inventory.mjs  어느 서비스가 어느 벤더 키를 쓰는지 훑기
#
# 발급: Vercel → Account Settings → Tokens.
# ⚠️ 토큰의 팀과 대상 프로젝트의 팀이 **같아야** 합니다 (docs/subdomain-runbook.md §4).
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=
