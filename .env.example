# =============================================================================
# API_usage — 비용 대시보드 환경변수 템플릿
# =============================================================================
# 사용법:
#   cp .env.example .env  후 값 채우기. .env 는 절대 커밋하지 말 것(.gitignore 등록됨).
#
# 이 값들이 쓰이는 곳:
#   - 로컬 docker-compose Grafana: provisioning YAML 안에서 $VAR / ${VAR} 로 치환됨
#     (Grafana는 provisioning 파일 로드 시 환경변수를 자동 보간)
#   - Grafana Cloud(무료 티어): provisioning 파일 업로드가 불가하므로,
#     아래 값들을 Infinity 데이터소스 설정 UI의 Secure 필드에 직접 입력해야 함.
#     즉 이 파일은 "어떤 값이 필요한지"의 단일 목록 + 로컬 개발용으로 사용.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Anthropic Admin API  (조직 단위 토큰 사용량 / 비용)
# -----------------------------------------------------------------------------
# 발급: Console → Settings → Admin keys (조직 Owner 권한 필요)
#       일반 API 키(sk-ant-api...)로는 호출 불가. 반드시 Admin 키.
# 인증 헤더: x-api-key: $ANTHROPIC_ADMIN_KEY
#            anthropic-version: $ANTHROPIC_API_VERSION
# 주요 엔드포인트:
#   GET https://api.anthropic.com/v1/organizations/cost_report
#       ?starting_at=2026-08-01T00:00:00Z&bucket_width=1d
#   GET https://api.anthropic.com/v1/organizations/usage_report/messages
#       ?starting_at=...&bucket_width=1d&group_by[]=api_key_id&group_by[]=model
ANTHROPIC_ADMIN_KEY=sk-ant-admin01-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_VERSION=2023-06-01
ANTHROPIC_API_BASE=https://api.anthropic.com
# (선택) 대시보드 변수 기본값으로 쓸 조직 식별자
ANTHROPIC_ORG_ID=


# -----------------------------------------------------------------------------
# 2. Vercel API  (배포 / 사용량)
# -----------------------------------------------------------------------------
# 발급: Vercel Dashboard → Account Settings → Tokens
#       팀 리소스를 볼 거면 토큰 scope 를 해당 Team 으로 지정할 것.
# 인증 헤더: Authorization: Bearer $VERCEL_API_TOKEN
# 팀 계정이면 대부분의 엔드포인트에 ?teamId=$VERCEL_TEAM_ID 쿼리 필요.
#
# 청구 데이터 엔드포인트 (2026-02-19 changelog 로 공개된 정식 API):
#   GET https://api.vercel.com/v1/billing/charges?from=<ISO>&to=<ISO>&teamId=<id>
#   FOCUS v1.3 표준의 JSONL 응답. BilledCost / EffectiveCost 로 실제 USD 금액이 나옵니다.
#   1일 granularity, 최대 1년 범위, 페이지네이션 없음.
#   필요 역할: Owner / Member / Developer / Security / Billing / Enterprise Viewer
#   ※ 무료 Hobby 플랜은 청구 항목이 없어 빈 응답일 수 있습니다.
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=
VERCEL_API_BASE=https://api.vercel.com
# (선택) 특정 프로젝트만 추적할 경우 — 쉼표 구분
VERCEL_PROJECT_IDS=


# -----------------------------------------------------------------------------
# 3. Supabase Management API  (프로젝트 / 조직 사용량)
# -----------------------------------------------------------------------------
# 발급: https://supabase.com/dashboard/account/tokens → Personal Access Token (sbp_...)
#       PAT 는 계정 전체 권한이라 취급 주의. 만료 주기적으로 회전 권장.
# 인증 헤더: Authorization: Bearer $SUPABASE_ACCESS_TOKEN
# 주요 엔드포인트:
#   GET https://api.supabase.com/v1/projects
#   GET https://api.supabase.com/v1/organizations
#
# ⚠️ 확인 완료 (2026-08-25, OpenAPI 스펙 115개 경로 전수 확인):
#    **금액(USD)을 주는 엔드포인트가 없습니다.** 대시보드 Usage & Billing 화면은
#    공개 API 가 아닌 내부 platform/ API 를 씁니다. 그래서 이 대시보드의 Supabase 비용은
#    조직 플랜 정액 + 애드온 정액(/billing/addons 의 실제 단가)을 일할한 **추정치**입니다.
#    종량 과금 초과분(대역폭·저장용량·MAU)은 반영되지 않습니다.
#    실제로 쓰는 경로:
#      GET /v1/projects
#      GET /v1/organizations, /v1/organizations/{slug}          (plan 은 단건 조회에만)
#      GET /v1/projects/{ref}/analytics/endpoints/usage.api-counts?interval=1day
#      GET /v1/projects/{ref}/billing/addons                    (금액이 나오는 유일한 곳)
#
# ★ 계정이 여러 개인 경우 — 여기가 Anthropic·Vercel 과 다릅니다.
#   Supabase 의 PAT 는 **한 사람의 계정에 묶입니다.** 한 토큰으로 그 사람이 속한 모든
#   조직은 볼 수 있지만, 다른 계정 소유 프로젝트는 절대 안 보입니다.
#   따라서 계정이 3개면 **각 계정으로 로그인해 토큰을 3개 발급**해서 아래처럼 나열합니다.
#   형식: 쉼표(또는 줄바꿈)로 구분한 `라벨=토큰`. 라벨은 대시보드 "계정" 표에 그대로 뜹니다.
#   (구분자는 = 와 : 둘 다 됩니다. 라벨을 생략하면 "계정 1", "계정 2" 로 붙습니다.)
SUPABASE_ACCESS_TOKENS=회사=sbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx,개인=sbp_yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
#
# 계정이 하나뿐이면 위를 비워 두고 이쪽만 채워도 됩니다 (라벨은 SUPABASE_ACCOUNT_LABEL).
SUPABASE_ACCESS_TOKEN=
SUPABASE_ACCOUNT_LABEL=
SUPABASE_API_BASE=https://api.supabase.com
#
# ⚠️ 아래 둘은 **현재 코드가 읽지 않습니다.** /v1/projects 가 토큰으로 접근 가능한 조직·
#    프로젝트를 전부 돌려주므로 따로 지정할 필요가 없어졌습니다. 특정 프로젝트만 보고 싶어
#    지면 그때 다시 씁니다.
SUPABASE_ORG_SLUG=
SUPABASE_PROJECT_REFS=


# -----------------------------------------------------------------------------
# 4. Grafana  (로컬 스택 / Cloud)
# -----------------------------------------------------------------------------
# 로컬 docker-compose 로 Grafana 를 띄워 대시보드를 먼저 개발한 뒤
# JSON 을 Grafana Cloud 로 import 하는 흐름을 가정.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-locally
GRAFANA_PORT=3000
# Infinity 플러그인 자동 설치용
GF_INSTALL_PLUGINS=yesoreyeram-infinity-datasource

# Grafana Cloud (대시보드를 API 로 밀어 넣을 때만 필요. UI 로 import 하면 불필요)
# 발급: Grafana Cloud → Administration → Users and access → Service accounts → token
GRAFANA_CLOUD_URL=https://<your-stack>.grafana.net
GRAFANA_CLOUD_SA_TOKEN=


# -----------------------------------------------------------------------------
# 5. 대시보드 공통 설정
# -----------------------------------------------------------------------------
# 비용 집계 기준 통화 (환산은 하지 않음 — 각 API 가 반환하는 통화 그대로 표기)
DASHBOARD_CURRENCY=USD
# 기본 조회 구간 (일)
DASHBOARD_DEFAULT_RANGE_DAYS=30
# 타임존 (Grafana 대시보드 timezone 설정과 일치시킬 것)
DASHBOARD_TIMEZONE=Asia/Seoul

# -----------------------------------------------------------------------------
# 6. 대시보드 데이터 소스 스위치
# -----------------------------------------------------------------------------
# mock = mock/*.json 목업 데이터 사용 (API 키 불필요)
# api  = 실제 API 호출 (위의 키가 채워져 있어야 함)
# 읽는 곳: lib/data-source.ts — 목업/실API 분기는 이 파일 한 곳뿐
DATA_SOURCE=mock
