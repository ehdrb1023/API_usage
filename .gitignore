# 환경변수 — 실제 키가 들어가는 파일은 절대 커밋 금지
.env
.env.*
!.env.example

# Grafana 로컬 스택 데이터
grafana-data/
*.db

# OS / 에디터
.DS_Store
*.swp
.idea/
.vscode/

# 임시 응답 덤프 (API 응답에 키/조직정보가 섞일 수 있음)
tmp/
*.response.json

# API 응답 — 워크스페이스 ID·API 키 ID·프로젝트명 등 조직 내부 식별자가 들어감
responses/*.json
responses/*.jsonl
!responses/.gitkeep

# python 캐시
__pycache__/
*.pyc

# Next.js
/node_modules
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts
.vercel
